# Local development uses a file-backed libSQL database.
DATABASE_URL=./data/rankit.sqlite
# Turso takes precedence over DATABASE_URL when both variables are set.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
AUTH_SECRET=replace-with-a-long-random-value
APP_URL=http://localhost:3000
APP_PORT=3000
AUTO_MIGRATE_DATABASE=false
# Leave empty in development to print magic links in the server terminal.
RESEND_API_KEY=
EMAIL_FROM=GeoPostcodes Ranking <ranking@example.com>
# Comma-separated domains. Used to bootstrap an empty installation.
INITIAL_ALLOWED_DOMAINS=example.com
